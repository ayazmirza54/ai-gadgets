# Copy to .env.local for local builds, or set these in Vercel → Project → Settings → Environment Variables.
# Each one is optional: the tag/script is only added to the site when the value is set.

# Google Search Console → Add property → URL prefix → HTML tag → copy only the content="..." value
VITE_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Add site → HTML Meta Tag → copy only the content="..." value (msvalidate.01)
VITE_BING_SITE_VERIFICATION=

# Microsoft Clarity → New project → Settings → Overview → Project ID
VITE_CLARITY_PROJECT_ID=
